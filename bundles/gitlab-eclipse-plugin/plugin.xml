<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
	<extension point="org.eclipse.ui.views">
		<category name="GitLab" id="gitlab-eclipse-plugin"></category>

		<!-- TODO: Use perspective to pin the view to the right for new users. Renaming the view is helpful for testing first time UX. -->
		<view id="com.gitlab.eclipse.views.LanguageServerBrowserView"
			category="gitlab-eclipse-plugin"
			class="com.gitlab.eclipse.views.LanguageServerBrowserView"
			name="GitLab Duo"
			icon="icons/notification.png"
			inject="true">
		</view>
	</extension>


	<extension point="org.eclipse.ui.preferencePages">
		<page id="com.gitlab.eclipse.preferences.GitLabPreferencePage"
			name="GitLab"
			class="com.gitlab.eclipse.preferences.GitLabPreferencePage">
		</page>
	</extension>

	<extension point="org.eclipse.core.runtime.preferences">
		<initializer class="com.gitlab.eclipse.preferences.PreferenceInitializer"/>
	</extension>

	<extension point="org.eclipse.lsp4e.languageServer">
		<server
			class="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
			clientImpl="com.gitlab.eclipse.lsp.GitLabLanguageClient"
			id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
			label="GitLab Duo"
			serverInterface="com.gitlab.eclipse.lsp.GitLabLanguageServer"
			singleton="true">
		</server>

		<!--
			Wondering where the content types come from?
				1. Under "Preferences > Content Types", expand "Text".
				2. Select a language, select "Add Child".
		     	3. Export your preferences.
		     	4. Search for the "baseTypeId" of newly created userCreated preferences in this format:
					/instance/userCreated1726669809672/baseTypeId=org.eclipse.jdt.core.javaSource
					/instance/userCreated1726669809672/name=Custom Sub-type of Java Source File
				5. Create new content-type elements under the contentTypes extension point with the specified alias-for call.
	    -->

		<!-- NOTE: Support Code Suggestions in any editors created descended from the Text or XML content types. -->
		<!-- TODO: Normalize languageId to match the VS Code language client standard. -->
		<contentTypeMapping contentType="org.eclipse.core.runtime.text"
							id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider">
		</contentTypeMapping>

		<contentTypeMapping contentType="org.eclipse.core.runtime.xml"
							id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
							languageId="xml">
		</contentTypeMapping>

		<!-- TODO: Use aliases for JDT core sources. -->
		<contentTypeMapping contentType="org.eclipse.jdt.core.javaSource"
							id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
							languageId="java">
		</contentTypeMapping>

		<!-- TODO: Use aliases for Web Tools sources. -->
		<contentTypeMapping contentType="org.eclipse.wst.css.core.csssource"
							id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
							languageId="css">
		</contentTypeMapping>

		<contentTypeMapping contentType="org.eclipse.wst.jsdt.core.jsSource"
							id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
							languageId="javascript">
		</contentTypeMapping>

		<contentTypeMapping contentType="org.eclipse.wst.jsdt.core.jsonSource"
							id="com.gitlab.eclipse.lsp.GitLabLanguageServerProvider"
							languageId="json">
		</contentTypeMapping>
	</extension>

	<extension point="org.eclipse.ui.startup">
		<startup class="com.gitlab.eclipse.lsp.install.LanguageServerStartup"/>
		<startup class="com.gitlab.eclipse.suggestions.ui.SuggestionStartup"/>
	</extension>

	<extension point="org.eclipse.ui.workbench.texteditor.codeMiningProviders">
		<codeMiningProvider
			class="com.gitlab.eclipse.suggestions.ui.GhostTextCodeMiningProvider"
			id="com.gitlab.eclipse.suggestions.ghostTextProvider"
			label="GitLab Duo Code Suggestions">
		</codeMiningProvider>
	</extension>

	<extension point="org.eclipse.ui.commands">
		<category id="com.gitlab.eclipse.commands.category" name="GitLab Duo"/>
		<command id="com.gitlab.eclipse.commands.acceptSuggestion"
			categoryId="com.gitlab.eclipse.commands.category" name="Accept Code Suggestion"/>
		<command id="com.gitlab.eclipse.commands.acceptSuggestionWord"
			categoryId="com.gitlab.eclipse.commands.category" name="Accept Next Word of Code Suggestion"/>
		<command id="com.gitlab.eclipse.commands.dismissSuggestion"
			categoryId="com.gitlab.eclipse.commands.category" name="Dismiss Code Suggestion"/>
		<command id="com.gitlab.eclipse.commands.triggerSuggestion"
			categoryId="com.gitlab.eclipse.commands.category" name="Trigger Code Suggestion"/>
	</extension>

	<extension point="org.eclipse.ui.handlers">
		<handler commandId="com.gitlab.eclipse.commands.acceptSuggestion"
			class="com.gitlab.eclipse.suggestions.ui.AcceptSuggestionHandler"/>
		<handler commandId="com.gitlab.eclipse.commands.acceptSuggestionWord"
			class="com.gitlab.eclipse.suggestions.ui.AcceptNextWordHandler"/>
		<handler commandId="com.gitlab.eclipse.commands.dismissSuggestion"
			class="com.gitlab.eclipse.suggestions.ui.DismissSuggestionHandler"/>
		<handler commandId="com.gitlab.eclipse.commands.triggerSuggestion"
			class="com.gitlab.eclipse.suggestions.ui.TriggerSuggestionHandler"/>
	</extension>

	<extension point="org.eclipse.ui.contexts">
		<context id="com.gitlab.eclipse.suggestionVisible"
			name="GitLab Code Suggestion Visible"
			description="Active while an inline code suggestion is showing"
			parentId="org.eclipse.ui.textEditorScope"/>
	</extension>

	<!-- TAB/ESCはtextEditorScopeに直接バインドし、ハンドラのisEnabled()で候補が無いとき
	     バインドを無効化して通常編集へ素通しする(Copilot for Eclipse実証済みパターン)。
	     独自コンテキストはM1+ARROW_RIGHT(単語受け入れ)のみに使う。 -->
	<extension point="org.eclipse.ui.bindings">
		<key commandId="com.gitlab.eclipse.commands.acceptSuggestion"
			contextId="org.eclipse.ui.textEditorScope"
			schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
			sequence="TAB"/>
		<key commandId="com.gitlab.eclipse.commands.dismissSuggestion"
			contextId="org.eclipse.ui.textEditorScope"
			schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
			sequence="ESC"/>
		<key commandId="com.gitlab.eclipse.commands.acceptSuggestionWord"
			contextId="com.gitlab.eclipse.suggestionVisible"
			schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
			sequence="M1+ARROW_RIGHT"/>
		<key commandId="com.gitlab.eclipse.commands.triggerSuggestion"
			contextId="org.eclipse.ui.textEditorScope"
			schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
			sequence="M1+M3+/"/>
	</extension>
</plugin>
