<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.commands">
        <category name="GitLab Duo" id="gitlab-eclipse-plugin"/>

        <command
                id="com.gitlab.eclipse.codesuggestions.acceptSuggestionLine"
                name="Accept Suggestion Line"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="com.gitlab.eclipse.codesuggestions.acceptSuggestionWord"
                name="Accept Suggestion Word"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="com.gitlab.eclipse.codesuggestions.requestSuggestion"
                name="Request Suggestion"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="com.gitlab.eclipse.codesuggestions.rejectSuggestion"
                name="Reject Suggestion"
                categoryId="gitlab-eclipse-plugin"
        />

        <command
                id="com.gitlab.eclipse.codesuggestions.acceptSuggestion"
                name="Accept Suggestion"
                categoryId="gitlab-eclipse-plugin"
        />

        <command
                id="com.gitlab.eclipse.codesuggestions.cycleSuggestion.next"
                name="Cycle to Next Suggestion"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="com.gitlab.eclipse.codesuggestions.cycleSuggestion.prev"
                name="Cycle to Previous Suggestion"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.OpenDuoChat"
                name="Open Duo Chat Window"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.CloseDuoChat"
                name="Close Duo Chat Window"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.FocusDuoChat"
                name="Focus Duo Chat Window"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.NewChatConversation"
                name="New Duo Chat Conversation"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.SelectChatWebview"
                name="Switch Duo Chat Mode"
                categoryId="gitlab-eclipse-plugin">
            <commandParameter
                    id="gitlab-eclipse-plugin.commands.SelectChatWebview.webviewId"
                    name="Webview Id"
                    optional="true"/>
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.toggleCodeSuggestions"
                name="Toggle Code Suggestions"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.ShowIssues"
                name="Show GitLab Issues Assigned To Me"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.OpenActiveFile"
                name="Open Active File in GitLab"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.CopyLinkToActiveFile"
                name="Copy GitLab Link to Active File"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.OpenInGitLab"
                name="Open Project in GitLab"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.CopyLinkToClipboard"
                name="Copy GitLab Project Link"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.OpenCreateNewIssue"
                name="Create New Issue in GitLab"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.OpenMcpUserConfig"
                name="Open MCP User Configuration"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.OpenMcpWorkspaceConfig"
                name="Open MCP Workspace Configuration"
                categoryId="gitlab-eclipse-plugin">
        </command>

        <command
                id="gitlab-eclipse-plugin.commands.RestartLanguageServer"
                name="Restart GitLab Language Server"
                categoryId="gitlab-eclipse-plugin">
        </command>
    </extension>

    <extension point="org.eclipse.ui.contexts">
        <context
            name="Code Suggestions context"
            id="com.gitlab.eclipse.codesuggestions.context"
            parentId="org.eclipse.ui.textEditorScope">
        </context>
    </extension>

    <extension point="org.eclipse.ui.bindings">
        <key
                sequence="M1+."
                commandId="com.gitlab.eclipse.codesuggestions.requestSuggestion"
                contextId="org.eclipse.ui.textEditorScope"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="ESC"
                commandId="com.gitlab.eclipse.codesuggestions.rejectSuggestion"
                contextId="org.eclipse.ui.textEditorScope"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="TAB"
                commandId="com.gitlab.eclipse.codesuggestions.acceptSuggestion"
                contextId="org.eclipse.ui.textEditorScope"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="M1+ARROW_RIGHT"
                commandId="com.gitlab.eclipse.codesuggestions.acceptSuggestionLine"
                contextId="com.gitlab.eclipse.codesuggestions.context"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="M3+ARROW_RIGHT"
                commandId="com.gitlab.eclipse.codesuggestions.acceptSuggestionWord"
                contextId="com.gitlab.eclipse.codesuggestions.context"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="M3+]"
                commandId="com.gitlab.eclipse.codesuggestions.cycleSuggestion.next"
                contextId="org.eclipse.ui.textEditorScope"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="M3+["
                commandId="com.gitlab.eclipse.codesuggestions.cycleSuggestion.prev"
                contextId="org.eclipse.ui.textEditorScope"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>

        <key
                sequence="M3+D"
                commandId="gitlab-eclipse-plugin.commands.OpenDuoChat"
                contextId="org.eclipse.ui.textEditorScope"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
        </key>
    </extension>

    <extension point="org.eclipse.ui.services">
        <sourceProvider provider="com.gitlab.eclipse.chat.DuoChatStateService">
            <variable name="duo_chat_enabled" priorityLevel="workbench"/>
        </sourceProvider>

        <sourceProvider provider="com.gitlab.eclipse.chat.ChatAvailabilityService">
            <variable name="duo_chat_available" priorityLevel="workbench"/>
        </sourceProvider>

        <sourceProvider provider="com.gitlab.eclipse.utils.theming.ThemeSourceProvider">
            <variable name="theme_tone" priorityLevel="workbench"/>
        </sourceProvider>

        <sourceProvider provider="com.gitlab.eclipse.utils.system.SystemSourceProvider">
            <variable name="os" priorityLevel="workbench"/>
        </sourceProvider>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page id="com.gitlab.eclipse.preferences.GitLabPreferencePage"
              name="GitLab Duo"
              class="com.gitlab.eclipse.preferences.GitLabPreferencePage">
        </page>
    </extension>

    <extension point="org.eclipse.core.runtime.preferences">
        <initializer class="com.gitlab.eclipse.preferences.PreferenceInitializer"/>
    </extension>

    <extension point="org.eclipse.ui.views">
        <category name="GitLab" id="gitlab-eclipse-plugin"/>

        <!-- TODO: Use perspective to pin the view to the right for new users. Renaming the view is helpful for testing first time UX. -->
        <view id="com.gitlab.eclipse.views.LanguageServerBrowserView"
              category="gitlab-eclipse-plugin"
              class="com.gitlab.eclipse.views.LanguageServerBrowserView"
              name="GitLab Duo"
              icon="icons/notification.png"
              inject="true"
        />

        <view id="com.gitlab.eclipse.views.IssuesView"
              category="gitlab-eclipse-plugin"
              class="com.gitlab.eclipse.views.issues.IssuesView"
              name="GitLab Issues"
              icon="icons/notification.png"
              inject="true"
        />
    </extension>

    <extension point="org.eclipse.ui.perspectiveExtensions">
        <perspectiveExtension targetID="*">
            <view
                    id="com.gitlab.eclipse.views.LanguageServerBrowserView"
                    relative="org.eclipse.ui.editorss"
                    relationship="right"
                    visible="false"
            />
        </perspectiveExtension>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.AcceptCodeSuggestionsLineHandler"
                commandId="com.gitlab.eclipse.codesuggestions.acceptSuggestionLine"
        />

        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.AcceptCodeSuggestionsWordHandler"
                commandId="com.gitlab.eclipse.codesuggestions.acceptSuggestionWord"
        />

        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.AcceptCodeSuggestionsHandler"
                commandId="com.gitlab.eclipse.codesuggestions.acceptSuggestion"
        />

        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.RejectCodeSuggestionsHandler"
                commandId="com.gitlab.eclipse.codesuggestions.rejectSuggestion"
        />

        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.RequestCodeSuggestionHandler"
                commandId="com.gitlab.eclipse.codesuggestions.requestSuggestion"
        />

        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.CycleToNextCodeSuggestionHandler"
                commandId="com.gitlab.eclipse.codesuggestions.cycleSuggestion.next"
        />

        <handler
                class="com.gitlab.eclipse.codesuggestions.handlers.CycleToPreviousCodeSuggestionHandler"
                commandId="com.gitlab.eclipse.codesuggestions.cycleSuggestion.prev"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.OpenDuoChat"
                class="com.gitlab.eclipse.chat.commands.OpenDuoChatCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.CloseDuoChat"
                class="com.gitlab.eclipse.chat.commands.CloseDuoChatCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.FocusDuoChat"
                class="com.gitlab.eclipse.chat.commands.OpenDuoChatCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.NewChatConversation"
                class="com.gitlab.eclipse.chat.commands.NewChatConversationCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.SelectChatWebview"
                class="com.gitlab.eclipse.chat.commands.SelectChatWebviewCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.ExplainCode"
                class="com.gitlab.eclipse.chat.commands.ExplainCodeCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.FixCode"
                class="com.gitlab.eclipse.chat.commands.FixCodeCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.GenerateTests"
                class="com.gitlab.eclipse.chat.commands.GenerateTestsCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.RefactorCode"
                class="com.gitlab.eclipse.chat.commands.RefactorCodeCommandHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.showPluginStatus"
                class="com.gitlab.eclipse.handlers.ShowPluginStatusMenu"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.showSettings"
                class="com.gitlab.eclipse.handlers.ShowSettings"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.showDocumentation"
                class="com.gitlab.eclipse.handlers.ShowDocumentation"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.chatStatus"
                class="com.gitlab.eclipse.chat.commands.ChatStatusHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.codeSuggestionsStatus"
                class="com.gitlab.eclipse.codesuggestions.handlers.CodeSuggestionsStatusHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.toggleCodeSuggestionsForLanguage"
                class="com.gitlab.eclipse.codesuggestions.handlers.ToggleCodeSuggestionForLanguageHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.toggleCodeSuggestions"
                class="com.gitlab.eclipse.codesuggestions.handlers.ToggleCodeSuggestionsHandler">
        </handler>

        <handler
                commandId="gitlab-eclipse-plugin.commands.ShowIssues"
                class="com.gitlab.eclipse.handlers.ShowIssuesHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.OpenActiveFile"
                class="com.gitlab.eclipse.handlers.OpenActiveFileHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.CopyLinkToActiveFile"
                class="com.gitlab.eclipse.handlers.CopyLinkToActiveFileHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.OpenInGitLab"
                class="com.gitlab.eclipse.handlers.OpenInGitLabHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.CopyLinkToClipboard"
                class="com.gitlab.eclipse.handlers.CopyLinkToClipboardHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.OpenCreateNewIssue"
                class="com.gitlab.eclipse.handlers.OpenCreateNewIssueHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.OpenMcpUserConfig"
                class="com.gitlab.eclipse.handlers.OpenMcpUserConfigHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.OpenMcpWorkspaceConfig"
                class="com.gitlab.eclipse.handlers.OpenMcpWorkspaceConfigHandler"
        />

        <handler
                commandId="gitlab-eclipse-plugin.commands.RestartLanguageServer"
                class="com.gitlab.eclipse.handlers.RestartLanguageServerHandler"
        />
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?endof">
            <toolbar id="com.gitlab.eclipse.toolbar">
                <command
                        id="com.gitlab.eclipse.toolbar"
                        commandId="gitlab-eclipse-plugin.commands.OpenDuoChat"
                        icon="icons/light/chat_on_obj.png"
                        tooltip="GitLab Duo Chat"
                >
                    <visibleWhen checkEnabled="false">
                        <and>
                            <with variable="duo_chat_available">
                                <equals value="true"/>
                            </with>
                            <with variable="theme_tone">
                                <equals value="dark"/>
                            </with>
                        </and>
                    </visibleWhen>
                </command>

                <command
                        id="com.gitlab.eclipse.toolbar"
                        commandId="gitlab-eclipse-plugin.commands.OpenDuoChat"
                        icon="icons/dark/chat_on_obj.png"
                        tooltip="GitLab Duo Chat"
                >
                    <visibleWhen checkEnabled="false">
                        <and>
                            <with variable="duo_chat_available">
                                <equals value="true"/>
                            </with>
                            <with variable="theme_tone">
                                <equals value="light"/>
                            </with>
                        </and>
                    </visibleWhen>
                </command>
            </toolbar>
        </menuContribution>
        <menuContribution locationURI="popup:#AbstractTextEditorContext">
            <menu id="com.gitlab.eclipse.chat.menu" label="GitLab Duo Chat" icon="icons/notification.png">
                <command
                        commandId="gitlab-eclipse-plugin.commands.OpenDuoChat"
                        label="Open Chat Window"
                        tooltip="Open Duo Chat Window"
                        icon="icons/dark/chat_on_obj.png"
                >
                    <visibleWhen checkEnabled="false">
                        <or>
                            <with variable="theme_tone">
                                <equals value="light"/>
                            </with>
                            <with variable="os">
                                <equals value="windows"/>
                            </with>
                        </or>
                    </visibleWhen>
                </command>

                <command
                        commandId="gitlab-eclipse-plugin.commands.OpenDuoChat"
                        label="Open Chat Window"
                        tooltip="Open Duo Chat Window"
                        icon="icons/light/chat_on_obj.png"
                >
                    <visibleWhen checkEnabled="false">
                        <and>
                            <with variable="theme_tone">
                                <equals value="dark"/>
                            </with>
                            <with variable="os">
                                <not>
                                    <equals value="windows"/>
                                </not>
                            </with>
                        </and>
                    </visibleWhen>
                </command>

                <command
                        commandId="gitlab-eclipse-plugin.commands.ExplainCode"
                        label="Explain Code"
                        tooltip="Explain the selected snippet"
                >
                    <visibleWhen checkEnabled="false">
                        <with variable="duo_chat_enabled">
                            <equals value="true"/>
                        </with>
                    </visibleWhen>
                </command>

                <command
                        commandId="gitlab-eclipse-plugin.commands.FixCode"
                        label="Fix Code"
                        tooltip="Fix the selected code snippet"
                >
                    <visibleWhen checkEnabled="false">
                        <with variable="duo_chat_enabled">
                            <equals value="true"/>
                        </with>
                    </visibleWhen>
                </command>

                <command
                        commandId="gitlab-eclipse-plugin.commands.GenerateTests"
                        label="Generate Tests"
                        tooltip="Write tests for the selected snippet"
                >
                    <visibleWhen checkEnabled="false">
                        <with variable="duo_chat_enabled">
                            <equals value="true"/>
                        </with>
                    </visibleWhen>
                </command>

                <command
                        commandId="gitlab-eclipse-plugin.commands.RefactorCode"
                        label="Refactor Code"
                        tooltip="Refactor the selected snippet"
                >
                    <visibleWhen checkEnabled="false">
                        <with variable="duo_chat_enabled">
                            <equals value="true"/>
                        </with>
                    </visibleWhen>
                </command>

                <command
                        commandId="gitlab-eclipse-plugin.commands.FocusDuoChat"
                        label="Focus Duo Chat"
                        tooltip="Bring the Duo Chat window to the front"/>

                <command
                        commandId="gitlab-eclipse-plugin.commands.CloseDuoChat"
                        label="Close Duo Chat"
                        tooltip="Close the Duo Chat window"/>

                <command
                        commandId="gitlab-eclipse-plugin.commands.NewChatConversation"
                        label="New Conversation"
                        tooltip="Start a new Duo Chat conversation"
                >
                    <visibleWhen checkEnabled="false">
                        <with variable="duo_chat_enabled">
                            <equals value="true"/>
                        </with>
                    </visibleWhen>
                </command>

                <visibleWhen checkEnabled="false">
                    <with variable="duo_chat_available">
                        <equals value="true"/>
                    </with>
                </visibleWhen>
            </menu>
        </menuContribution>

        <menuContribution locationURI="popup:#AbstractTextEditorContext?after=additions">
            <menu id="com.gitlab.eclipse.navigation.menu" label="GitLab">
                <command
                        commandId="gitlab-eclipse-plugin.commands.OpenActiveFile"
                        label="Open Active File in GitLab"
                />

                <command
                        commandId="gitlab-eclipse-plugin.commands.CopyLinkToActiveFile"
                        label="Copy Link to Active File"
                />

                <separator name="gitlab-eclipse-plugin.navigation.sep1" visible="true"/>

                <command
                        commandId="gitlab-eclipse-plugin.commands.OpenInGitLab"
                        label="Open Project in GitLab"
                />

                <command
                        commandId="gitlab-eclipse-plugin.commands.CopyLinkToClipboard"
                        label="Copy Project Link"
                />

                <command
                        commandId="gitlab-eclipse-plugin.commands.OpenCreateNewIssue"
                        label="Create New Issue"
                />
            </menu>
        </menuContribution>

        <!-- Chat-mode selector on the Duo Chat view toolbar: a pulldown whose menu offers the two
             chat webviews as plain push items (no radio state — the effective selection can change
             programmatically, e.g. a classic-only command forces classic, so a checked radio would
             go stale). Clicking the pulldown button itself just re-resolves the view. -->
        <menuContribution locationURI="toolbar:com.gitlab.eclipse.views.LanguageServerBrowserView">
            <command
                    commandId="gitlab-eclipse-plugin.commands.SelectChatWebview"
                    id="gitlab-eclipse-plugin.menus.chatSelectorMenu"
                    icon="icons/notification.png"
                    style="pulldown"
                    tooltip="Switch Duo Chat Mode">
            </command>
        </menuContribution>

        <menuContribution locationURI="menu:gitlab-eclipse-plugin.menus.chatSelectorMenu">
            <command
                    commandId="gitlab-eclipse-plugin.commands.SelectChatWebview"
                    label="Duo Chat (Classic)"
                    style="push"
                    tooltip="Show the classic Duo Chat webview">
                <parameter
                        name="gitlab-eclipse-plugin.commands.SelectChatWebview.webviewId"
                        value="duo-chat-v2"/>
            </command>

            <command
                    commandId="gitlab-eclipse-plugin.commands.SelectChatWebview"
                    label="Duo Chat (Agentic)"
                    style="push"
                    tooltip="Show the Agentic Duo Chat webview">
                <parameter
                        name="gitlab-eclipse-plugin.commands.SelectChatWebview.webviewId"
                        value="agentic-duo-chat"/>
            </command>
        </menuContribution>

        <menuContribution locationURI="toolbar:org.eclipse.ui.trim.status">
            <toolbar id="com.gitlab.eclipse.menus.trim" label="GitLab Duo">
                <command
                        commandId="gitlab-eclipse-plugin.commands.showPluginStatus"
                        icon="icons/notification.png"
                        id="gitlab-eclipse-plugin.menus.statusWidgetMenu"
                        style="pulldown"
                        tooltip="Show GitLab Status">
                </command>
            </toolbar>
        </menuContribution>

        <menuContribution locationURI="menu:gitlab-eclipse-plugin.menus.statusWidgetMenu">
            <command
                    commandId="gitlab-eclipse-plugin.commands.chatStatus"
                    id="gitlab-eclipse-plugin.commands.chatStatus"
                    label="Duo Chat: Disabled">
            </command>

            <command
                    commandId="gitlab-eclipse-plugin.commands.codeSuggestionsStatus"
                    id="gitlab-eclipse-plugin.commands.codeSuggestionsStatus"
                    label="Code Suggestions: Disabled">
            </command>

            <command
                    commandId="gitlab-eclipse-plugin.commands.toggleCodeSuggestions"
                    id="gitlab-eclipse-plugin.commands.toggleCodeSuggestions"
                    label="Disable Code Suggestions">
            </command>

            <separator name="StatusActions" visible="true"/>

            <command
                    commandId="gitlab-eclipse-plugin.commands.toggleCodeSuggestionsForLanguage"
                    id="gitlab-eclipse-plugin.commands.toggleCodeSuggestionsForLanguage"
                    label="No code suggestions action available."
            />

            <separator name="CodeSuggestionsLanguageActions" visible="true"/>

            <command
                    commandId="gitlab-eclipse-plugin.commands.showSettings"
                    id="gitlab-eclipse-plugin.commands.showSettings"
                    label="Show Settings">
            </command>

            <command
                    commandId="gitlab-eclipse-plugin.commands.showDocumentation"
                    id="gitlab-eclipse-plugin.menus.showDocumentation"
                    label="Show Documentation">
            </command>

            <command
                    commandId="gitlab-eclipse-plugin.commands.ShowIssues"
                    label="Issues Assigned To Me"
                    style="push"
            />

            <command
                    commandId="gitlab-eclipse-plugin.commands.OpenMcpUserConfig"
                    label="Open MCP User Configuration"
                    tooltip="Create/open the user-level GitLab Duo MCP config"/>

            <command
                    commandId="gitlab-eclipse-plugin.commands.OpenMcpWorkspaceConfig"
                    label="Open MCP Workspace Configuration"
                    tooltip="Create/open the workspace-level GitLab Duo MCP config"/>

            <command
                    commandId="gitlab-eclipse-plugin.commands.RestartLanguageServer"
                    label="Restart Language Server"
                    tooltip="Stop and restart the GitLab Language Server"/>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.editors.annotationTypes">
        <type
                name="codeSuggestionsMarker"
                markerType="codeSuggestionsMarker"
                super="org.eclipse.ui.workbench.texteditor.info">
        </type>
    </extension>

    <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
        <specification
                annotationType="codeSuggestionsMarker"
                annotationImageProvider="com.gitlab.eclipse.codesuggestions.annotation.CodeSuggestionsAnnotationImageProvider"
        >
        </specification>
    </extension>

    <extension point="org.eclipse.ui.workbench.texteditor.rulerColumns">
        <column
                id="gitlab-eclipse-plugin.duoRuler"
                name="GitLab Duo"
                class="com.gitlab.eclipse.utils.ruler.DuoAnnotationsRulerColumn"
                enabled="true"
                global="true"
        >
            <placement gravity="1.0">
                <after id="org.eclipse.ui.editors.columns.linenumbers"/>
            </placement>
            <targetEditor id="org.eclipse.ui.DefaultTextEditor"/>
            <targetClass class="org.eclipse.ui.texteditor.AbstractTextEditor"/>
        </column>
    </extension>
</plugin>
