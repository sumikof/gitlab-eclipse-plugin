Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: GitLab for Eclipse SWTBot Tests
Bundle-Vendor: GitLab
Automatic-Module-Name: com.gitlab.eclipse.swtbot
Bundle-SymbolicName: com.gitlab.eclipse.swtbot;singleton:=true
Bundle-Version: 0.7.7
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.junit,
    org.eclipse.ui,
    org.eclipse.core.runtime,
    org.eclipse.platform,
    org.eclipse.equinox.security,
    org.eclipse.swtbot.eclipse.finder,
    org.eclipse.swtbot.junit4_x,
    org.eclipse.swtbot.swt.finder,
    org.hamcrest.core,
    org.apache.log4j,
    com.gitlab.eclipse.gitlab-eclipse-plugin,
    com.gitlab.eclipse.gitlab-language-server,
    org.eclipse.equinox.security,
    org.eclipse.equinox.security.ui
Import-Package: org.slf4j;version="[1.7.0,2.0.0)"
