<?xml version="1.0" encoding="UTF-8"?>
<project
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
        xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>com.gitlab.eclipse.swtbot</artifactId>
    <packaging>eclipse-test-plugin</packaging>

    <parent>
        <groupId>com.gitlab.eclipse</groupId>
        <artifactId>plugin-group</artifactId>
        <version>0.8.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <ui.test.vmargs>-Dorg.eclipse.equinox.security.storage.JavaPreferences.noEncryption=true</ui.test.vmargs>
        <plugin.version.range>[0.8.3,0.8.4)</plugin.version.range>
    </properties>

    <profiles>
        <profile>
            <id>macosx-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties>
                <ui.test.vmargs>-XstartOnFirstThread -Dorg.eclipse.equinox.security.storage.JavaPreferences.noEncryption=true</ui.test.vmargs>
                <os.name>macosx</os.name>
                <ws.name>cocoa</ws.name>
                <arch.name>aarch64</arch.name>
                <platform.plugin.id>com.gitlab.eclipse.gitlab-language-server.cocoa.macosx.aarch64</platform.plugin.id>
            </properties>
        </profile>

        <profile>
            <id>macosx-x86_64</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <properties>
                <ui.test.vmargs>-XstartOnFirstThread -Dorg.eclipse.equinox.security.storage.JavaPreferences.noEncryption=true</ui.test.vmargs>
                <os.name>macosx</os.name>
                <ws.name>cocoa</ws.name>
                <arch.name>x86_64</arch.name>
                <platform.plugin.id>com.gitlab.eclipse.gitlab-language-server.cocoa.macosx.x86_64</platform.plugin.id>
            </properties>
        </profile>

        <profile>
            <id>windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <os.name>win32</os.name>
                <ws.name>win32</ws.name>
                <arch.name>x86_64</arch.name>
                <platform.plugin.id>com.gitlab.eclipse.gitlab-language-server.win32.win32.x86_64</platform.plugin.id>
            </properties>
        </profile>

        <profile>
            <id>linux</id>
            <activation>
                <os><family>linux</family></os>
            </activation>
            <properties>
                <os.name>linux</os.name>
                <ws.name>gtk</ws.name>
                <arch.name>x86_64</arch.name>
                <platform.plugin.id>com.gitlab.eclipse.gitlab-language-server.gtk.linux.x86_64</platform.plugin.id>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <environments>
                        <environment>
                            <os>${os.name}</os>
                            <ws>${ws.name}</ws>
                            <arch>${arch.name}</arch>
                        </environment>
                    </environments>
                    <pomDependencies>consider</pomDependencies>
                    <dependency-resolution>
                        <extraRequirements>
                            <requirement>
                                <type>eclipse-plugin</type>
                                <id>${platform.plugin.id}</id>
                                <versionRange>${plugin.version.range}</versionRange>
                            </requirement>
                        </extraRequirements>
                    </dependency-resolution>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-surefire-plugin</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <useUIHarness>true</useUIHarness>
                    <useUIThread>false</useUIThread>
                    <argLine>${ui.test.vmargs}</argLine>
                    <application>org.eclipse.ui.ide.workbench</application>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
