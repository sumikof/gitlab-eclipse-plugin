<?xml version="1.0" encoding="UTF-8"?>
<site>
    <category-def name="com.gitlab.eclipse.category" label="GitLab">
        <description>
            Contains plugins for GitLab, GitLab Duo, GitLab Duo Workflow, and more.
        </description>
    </category-def>

    <bundle id="com.gitlab.eclipse.gitlab-eclipse-plugin">
        <category name="com.gitlab.eclipse.category"/>
    </bundle>

    <category-def name="com.gitlab.eclipse.lsp.category" label="GitLab Language Server">
        <category name="com.gitlab.eclipse.category"/>
        <description>
            Contains plugins for the GitLab language server client and platform-dependent server binaries.
        </description>
    </category-def>

    <bundle id="com.gitlab.eclipse.gitlab-language-server">
        <category name="com.gitlab.eclipse.lsp.category"/>
    </bundle>

    <bundle id="com.gitlab.eclipse.gitlab-language-server.gtk.linux.x86_64">
        <category name="com.gitlab.eclipse.lsp.category"/>
    </bundle>

    <bundle id="com.gitlab.eclipse.gitlab-language-server.cocoa.macosx.aarch64">
        <category name="com.gitlab.eclipse.lsp.category"/>
    </bundle>

    <bundle id="com.gitlab.eclipse.gitlab-language-server.cocoa.macosx.x86_64">
        <category name="com.gitlab.eclipse.lsp.category"/>
    </bundle>

    <bundle id="com.gitlab.eclipse.gitlab-language-server.win32.win32.x86_64">
        <category name="com.gitlab.eclipse.lsp.category"/>
    </bundle>
</site>
